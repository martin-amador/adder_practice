#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60e791bf3540 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x60e791bf36f0 .scope module, "simple_adder" "simple_adder" 3 2;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 8 "a";
    .port_info 2 /INPUT 8 "b";
    .port_info 3 /OUTPUT 8 "sum";
o0x7e743d6cf018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x60e791c04d50_0 .net "a", 7 0, o0x7e743d6cf018;  0 drivers
o0x7e743d6cf048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x60e791c05430_0 .net "b", 7 0, o0x7e743d6cf048;  0 drivers
o0x7e743d6cf078 .functor BUFZ 1, C4<z>; HiZ drive
v0x60e791c3b170_0 .net "clk", 0 0, o0x7e743d6cf078;  0 drivers
v0x60e791c3b240_0 .var "sum", 7 0;
E_0x60e791c2c870 .event posedge, v0x60e791c3b170_0;
    .scope S_0x60e791bf36f0;
T_0 ;
    %wait E_0x60e791c2c870;
    %load/vec4 v0x60e791c04d50_0;
    %load/vec4 v0x60e791c05430_0;
    %add;
    %assign/vec4 v0x60e791c3b240_0, 0;
    %jmp T_0;
    .thread T_0;
